{
  "name": "postquantum-jwt",
  "displayName": "PostQuantum.Jwt",
  "description": "Visual token inspector, hybrid-construction & validation-flow diagrams, snippets, and quick links for the PostQuantum.Jwt .NET library (ML-DSA-65 + X-Wing).",
  "version": "0.2.2",
  "publisher": "systemslibrarian",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0B1021",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Snippets",
    "Visualization",
    "Education",
    "Other"
  ],
  "keywords": [
    "jwt",
    "jose",
    "post-quantum",
    "pqc",
    "ml-dsa",
    "ml-kem",
    "x-wing",
    "csharp",
    "dotnet",
    "cryptography"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/systemslibrarian/postquantum-jwt",
    "directory": "tools/vscode"
  },
  "homepage": "https://github.com/systemslibrarian/postquantum-jwt/tree/main/tools/vscode#readme",
  "bugs": {
    "url": "https://github.com/systemslibrarian/postquantum-jwt/issues"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:csharp",
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:http"
  ],
  "contributes": {
    "snippets": [
      {
        "language": "csharp",
        "path": "./snippets/csharp.json"
      }
    ],
    "commands": [
      {
        "command": "pqjwt.openInspector",
        "title": "PostQuantum.Jwt: Inspect Token (Visual)"
      },
      {
        "command": "pqjwt.decodeToken",
        "title": "PostQuantum.Jwt: Decode Token (Text)"
      },
      {
        "command": "pqjwt.showHybridConstruction",
        "title": "PostQuantum.Jwt: Show Hybrid Construction Diagram"
      },
      {
        "command": "pqjwt.showValidationFlow",
        "title": "PostQuantum.Jwt: Show Validation Flow"
      },
      {
        "command": "pqjwt.openPlayground",
        "title": "PostQuantum.Jwt: Open Live Playground"
      },
      {
        "command": "pqjwt.openDocs",
        "title": "PostQuantum.Jwt: Open Docs (README)"
      },
      {
        "command": "pqjwt.openNuget",
        "title": "PostQuantum.Jwt: Open on NuGet"
      },
      {
        "command": "pqjwt.openRepo",
        "title": "PostQuantum.Jwt: Open GitHub Repository"
      },
      {
        "command": "pqjwt.generateKeyPair",
        "title": "PostQuantum.Jwt: Generate a Key Pair (in Playground)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pqjwt.openInspector",
          "when": "editorHasSelection",
          "group": "navigation@8"
        },
        {
          "command": "pqjwt.decodeToken",
          "when": "editorHasSelection",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "pqjwt.openInspector",
          "when": "true"
        },
        {
          "command": "pqjwt.decodeToken",
          "when": "true"
        }
      ]
    },
    "configuration": {
      "title": "PostQuantum.Jwt",
      "properties": {
        "pqjwt.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the inline 'Inspect PQ-JWT' / docs CodeLenses above detected tokens and API symbols."
        },
        "pqjwt.inspector.openToSide": {
          "type": "boolean",
          "default": true,
          "description": "Open the visual token inspector in a column beside the editor instead of replacing it."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "pqjwt.gettingStarted",
        "title": "Understand post-quantum JWTs",
        "description": "See how PostQuantum.Jwt builds and validates ML-DSA-65 + X-Wing tokens — visually, with no crypto run on your machine.",
        "steps": [
          {
            "id": "pqjwt.step.inspect",
            "title": "Inspect a token visually",
            "description": "Run __PostQuantum.Jwt: Inspect Token (Visual)__ (or click the 🔍 Inspect PQ-JWT CodeLens above any token). Paste a token, or just try it — the inspector colors each segment and decodes the header.\n[Inspect Token](command:pqjwt.openInspector)",
            "media": {
              "markdown": "media/walkthrough/inspect.md"
            }
          },
          {
            "id": "pqjwt.step.signed-vs-encrypted",
            "title": "Signed vs. encrypted",
            "description": "A signed token has 3 segments; an encrypted token has 5 and wraps a signed token (sign-then-encrypt). The inspector labels every lane.",
            "media": {
              "markdown": "media/walkthrough/forms.md"
            }
          },
          {
            "id": "pqjwt.step.hybrid",
            "title": "How the hybrid is built",
            "description": "Open the __Hybrid construction__ view to see sign → X-Wing encapsulate → AES-256-GCM, including the X-Wing combiner.\n[Show Hybrid Construction](command:pqjwt.showHybridConstruction)",
            "media": {
              "markdown": "media/walkthrough/hybrid.md"
            }
          },
          {
            "id": "pqjwt.step.validation",
            "title": "How validation fails closed",
            "description": "Open the __Validation flow__ view for the 8 ordered checks the validator runs — and exactly what makes each one reject.\n[Show Validation Flow](command:pqjwt.showValidationFlow)",
            "media": {
              "markdown": "media/walkthrough/validation.md"
            }
          },
          {
            "id": "pqjwt.step.code",
            "title": "Write the code",
            "description": "Type a snippet prefix in a C# file — `pqjwt-quick`, `pqjwt-sign`, `pqjwt-encrypt`, `pqjwt-rotate`, `pqjwt-aspnetcore` — and tab through a working example.",
            "media": {
              "markdown": "media/walkthrough/code.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test": "npm run compile && node --test \"out/**/*.test.js\"",
    "test:integration": "npm run compile && node ./out/test/runTests.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.0",
    "eslint": "^9.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  }
}
