<Project>

  <!--
    Shared build settings for all projects in the PostQuantum.Jwt repository.
    Packaging metadata lives in the library .csproj; this file carries
    repo-wide compiler discipline and deterministic-build settings.
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Compiler-correctness warnings are errors; analyzer (CAxxxx) suggestions
         stay warnings so style opinions never block a build. -->
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- PQJWT100 = the [Obsolete] supersession notice on AddPqJwtBearer
         (PostQuantum.Jwt.AspNetCore is frozen at 1.0.0, superseded by
         PostQuantum.AspNetCore). In-repo samples and tests exercise the frozen
         package on purpose, so the notice is suppressed here; external
         source-builders still see it. Only this ID is suppressed — plain
         CS0618 obsoletions still fail the build. -->
    <NoWarn>$(NoWarn);PQJWT100</NoWarn>
  </PropertyGroup>

  <!-- Deterministic, reproducible builds -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- Repository-wide metadata -->
  <PropertyGroup>
    <Company>Paul Clark</Company>
    <Product>PostQuantum.Jwt</Product>
    <Copyright>Copyright © Paul Clark</Copyright>
  </PropertyGroup>

</Project>
