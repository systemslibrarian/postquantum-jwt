# ProductionDeploymentDemo environment template.
#
# Docker Compose sets these values for local development.
# Production deployments should use a real secret store, HTTPS/mTLS for key
# directory transport, and a durable key-management story.

# Issuer
PQJWT_ISSUER=https://issuer.production-demo.local
PQJWT_AUDIENCE=https://orders.production-demo.local
PQJWT_ENCRYPTED_TOKENS=true
ORDERS_RECIPIENT_KEY_URL=http://orders-api:8080/.well-known/pqjwt-recipient-key
PQJWT_RECIPIENT_KEY_REFRESH_SECONDS=30

# Orders API
ISSUER_KEYS_URL=http://issuer-api:8080/.well-known/pqjwt-keys
ALLOW_INSECURE_KEY_DIRECTORY=true
PQJWT_KEY_REFRESH_SECONDS=1

# Replay cache
REDIS_CONNECTION=redis:6379
