<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PostQuantum.Jwt.Benchmarks</RootNamespace>
    <AssemblyName>PostQuantum.Jwt.Benchmarks</AssemblyName>
    <!-- Not shipped: a developer tool for measuring the library, never packed. -->
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet requires public benchmark types/methods, but this is not
         a public API surface — don't force XML docs on it, and keep analyzer
         opinions as warnings (mirrors the test project's stance). -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Classical JWT baseline for an honest "what does post-quantum cost you?"
         comparison. JsonWebTokenHandler is Microsoft's MODERN, recommended
         handler — deliberately NOT the legacy System.IdentityModel.Tokens.Jwt
         JwtSecurityTokenHandler, so the baseline is the fastest reasonable
         classical path and the comparison never flatters this library by racing
         it against a deprecated one. Dev-tool dependency only; never shipped. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Benchmarks measure the library through its public API only; no InternalsVisibleTo. -->
    <ProjectReference Include="../../src/PostQuantum.Jwt/PostQuantum.Jwt.csproj" />
  </ItemGroup>

</Project>
