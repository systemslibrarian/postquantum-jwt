<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PostQuantum.Jwt</RootNamespace>
    <AssemblyName>PostQuantum.Jwt</AssemblyName>
    <!-- Trim/AOT awareness: most of the surface is trim-safe; the
         WithClaim(string,object?) overload uses reflection-based JSON
         serialization and is explicitly annotated with [RequiresUnreferencedCode]
         + [RequiresDynamicCode]. Consumers publishing AOT will see one warning
         pointing at that overload, and can switch to the source-gen
         WithClaim<T>(name, value, JsonTypeInfo<T>) overload to silence it. -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>PostQuantum.Jwt</PackageId>
    <Version>1.0.0</Version>
    <Title>PostQuantum.Jwt — JOSE-style post-quantum tokens for .NET</Title>
    <Authors>Paul Clark</Authors>
    <Description>Production-quality library for JOSE-style post-quantum tokens in controlled .NET issuer/verifier systems. Provides ML-DSA-65 signatures (FIPS 204), optional hybrid X-Wing-style confidentiality (X25519 + ML-KEM-768 with AES-256-GCM), strict algorithm handling, fail-closed validation, replay-protection support, and key-rotation patterns. Built on the native .NET BCL post-quantum primitives. NOT independently audited — treat that as a permanent, documented limitation (see KNOWN-GAPS.md), not a temporary gate. Suitable where you control both issuer and verifier; not a drop-in OAuth/OIDC/JWT replacement and not interoperable with generic JWT tooling.</Description>
    <PackageProjectUrl>https://github.com/systemslibrarian/postquantum-jwt</PackageProjectUrl>
    <RepositoryUrl>https://github.com/systemslibrarian/postquantum-jwt</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>jwt;jose;jwe;post-quantum;pqc;ml-dsa;ml-kem;dilithium;kyber;x-wing;x25519;sha3;hybrid;cryptography;security;fips-203;fips-204;net10</PackageTags>
    <PackageReleaseNotes>1.0.0: First stable release. The public API and v1 wire format are now under SemVer — held stable since the preview series and committed for 1.0.x. The wire format and public surface are unchanged from 1.0.0-preview.10; a pre-release review added two small hardening fixes (encryption-plaintext zeroing is now exception-safe; oversized-token rejections now emit the failure metric). IMPORTANT — the lack of an independent cryptographic audit is now a PERMANENT, documented limitation rather than a release gate: no third party has reviewed the design or implementation. Ship this only where you control both the issuer and every verifier and accept that risk with eyes open. NOT a drop-in OAuth/OIDC/JWT replacement; tokens do NOT interoperate with generic JWT/JWE tooling (the X-Wing key-management profile is not a standardized JOSE/JWE profile). Vulnerability reporting: GitHub Security Advisories (see SECURITY.md). Full notes: https://github.com/systemslibrarian/postquantum-jwt/blob/main/CHANGELOG.md — known limitations: https://github.com/systemslibrarian/postquantum-jwt/blob/main/KNOWN-GAPS.md.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Copyright>Copyright © Paul Clark</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <!-- Symbols + SourceLink for debuggable, reproducible packages.
       EnablePackageValidation catches accidental API breaks on subsequent versions. -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- API-surface baseline check. Opt-in via `-p:EnableBaselineValidation=true`
         once 0.2.0-preview.3 is on nuget.org; until then the pack would fail
         because the baseline package can't be resolved. Local builds and the
         default CI runs deliberately leave this off. -->
    <PackageValidationBaselineVersion Condition="'$(EnableBaselineValidation)' == 'true'">0.2.0-preview.3</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only dependency: BouncyCastle, used solely for X25519 (classical half of
         X-Wing) and SHA3-256 (the X-Wing combiner). ML-KEM-768 and ML-DSA come
         from the native .NET BCL. See SECURITY.md for the full posture. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../LICENSE" Pack="true" PackagePath="\" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Generate a CycloneDX SBOM (bom.json) inside the package on every Pack.
       Requires the `dotnet-CycloneDX` global tool (one-time install via
       `dotnet tool install` with the `global` flag and id `CycloneDX`).
       If the tool isn't present (e.g. on a fresh dev machine that hasn't
       installed it yet), pack continues without the SBOM rather than
       failing; the release workflow installs the tool unconditionally,
       so CI always produces the SBOM.

       The bom.json is added to the package via an in-target ItemGroup
       because $(IntermediateOutputPath)bom.json doesn't exist at the time
       a static <None Include> would be evaluated. -->
  <Target Name="GenerateCycloneDxSbom"
          BeforeTargets="GenerateNuspec;_GetPackageFiles"
          Condition="'$(IsPackable)' != 'false'">
    <Exec Command="dotnet CycloneDX &quot;$(MSBuildProjectFullPath)&quot; --output &quot;$(IntermediateOutputPath.TrimEnd('\').TrimEnd('/'))&quot; --filename bom.json --json"
          IgnoreExitCode="true"
          ContinueOnError="WarnAndContinue">
      <Output TaskParameter="ExitCode" PropertyName="_CycloneDxExitCode" />
    </Exec>
    <Message Importance="high"
             Text="CycloneDX SBOM not generated (tool missing or failed, exit=$(_CycloneDxExitCode)). Install with: `dotnet tool install` (global, id=CycloneDX)."
             Condition="'$(_CycloneDxExitCode)' != '0'" />
    <ItemGroup Condition="Exists('$(IntermediateOutputPath)bom.json')">
      <None Include="$(IntermediateOutputPath)bom.json" Pack="true" PackagePath="\" />
    </ItemGroup>
    <Message Importance="high"
             Text="CycloneDX SBOM packed into .nupkg at /bom.json"
             Condition="Exists('$(IntermediateOutputPath)bom.json')" />
  </Target>

</Project>
