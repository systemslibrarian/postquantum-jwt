<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PostQuantum.Jwt</RootNamespace>
    <AssemblyName>PostQuantum.Jwt</AssemblyName>
    <!-- Trim/AOT awareness: most of the surface is trim-safe; the
         WithClaim(string,object?) overload uses reflection-based JSON
         serialization and is explicitly annotated with [RequiresUnreferencedCode]
         + [RequiresDynamicCode]. Consumers publishing AOT will see one warning
         pointing at that overload, and can switch to the source-gen
         WithClaim<T>(name, value, JsonTypeInfo<T>) overload to silence it. -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>PostQuantum.Jwt</PackageId>
    <Version>1.0.0-preview.10</Version>
    <Title>PostQuantum.Jwt — JOSE-style post-quantum tokens for .NET</Title>
    <Authors>Paul Clark</Authors>
    <Description>Production-oriented preview library for JOSE-style post-quantum tokens in controlled .NET issuer/verifier systems. Provides ML-DSA-65 signatures (FIPS 204), optional hybrid X-Wing-style confidentiality (X25519 + ML-KEM-768 with AES-256-GCM), strict algorithm handling, fail-closed validation, replay-protection support, and key-rotation patterns. Built on the native .NET BCL post-quantum primitives. Not a production OAuth/OIDC/JWT replacement; not independently audited.</Description>
    <PackageProjectUrl>https://github.com/systemslibrarian/postquantum-jwt</PackageProjectUrl>
    <RepositoryUrl>https://github.com/systemslibrarian/postquantum-jwt</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>jwt;jose;jwe;post-quantum;pqc;ml-dsa;ml-kem;dilithium;kyber;x-wing;x25519;sha3;hybrid;cryptography;security;fips-203;fips-204;net10</PackageTags>
    <PackageReleaseNotes>1.0.0-preview.10: Targeted fixes on top of preview.9's concurrency hardening. INTEROP: PqJwtBearerHandler accepted the Authorization scheme as case-sensitive ("Bearer " only), in violation of RFC 9110 §11.1 ("auth-scheme tokens are case-insensitive") — requests with `Authorization: bearer ...` or `Authorization: BEARER ...` were rejected as no-result. The prefix check now uses StringComparison.OrdinalIgnoreCase. SAMPLES: samples/VerifierDemo was broken by preview.9's HttpPqJwtKeyRing IHostedService refactor — it never registered the hosted service or called PreloadAsync, so /verify failed with UnknownKeyId on every request. Refactored to the canonical preview.9+ pattern (singleton + hosted service + DI in bearer options) plus SocketsHttpHandler PooledConnectionLifetime=2min for DNS-TTL honouring. CODE QUALITY: samples/PqJwtPlayground now caches its validator instead of building a new one per Validate() call (was triggering its own PQJWT002 anti-pattern). PqJwtBearerHandler's dead validator cache simplified — the per-instance reference-equality short-circuit never fired because auth handlers are transient. Tokens produced by this library's builder are unaffected; the public API surface for token issue/validate is unchanged. Production-oriented preview: NOT independently audited, NOT a drop-in OAuth/OIDC/JWT replacement. Full notes: https://github.com/systemslibrarian/postquantum-jwt/blob/main/CHANGELOG.md — known limitations: https://github.com/systemslibrarian/postquantum-jwt/blob/main/KNOWN-GAPS.md.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Copyright>Copyright © Paul Clark</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <!-- Symbols + SourceLink for debuggable, reproducible packages.
       EnablePackageValidation catches accidental API breaks on subsequent versions. -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- API-surface baseline check. Opt-in via `-p:EnableBaselineValidation=true`
         once 0.2.0-preview.3 is on nuget.org; until then the pack would fail
         because the baseline package can't be resolved. Local builds and the
         default CI runs deliberately leave this off. -->
    <PackageValidationBaselineVersion Condition="'$(EnableBaselineValidation)' == 'true'">0.2.0-preview.3</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only dependency: BouncyCastle, used solely for X25519 (classical half of
         X-Wing) and SHA3-256 (the X-Wing combiner). ML-KEM-768 and ML-DSA come
         from the native .NET BCL. See SECURITY.md for the full posture. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../LICENSE" Pack="true" PackagePath="\" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Generate a CycloneDX SBOM (bom.json) inside the package on every Pack.
       Requires the `dotnet-CycloneDX` global tool (one-time install via
       `dotnet tool install` with the `global` flag and id `CycloneDX`).
       If the tool isn't present (e.g. on a fresh dev machine that hasn't
       installed it yet), pack continues without the SBOM rather than
       failing; the release workflow installs the tool unconditionally,
       so CI always produces the SBOM.

       The bom.json is added to the package via an in-target ItemGroup
       because $(IntermediateOutputPath)bom.json doesn't exist at the time
       a static <None Include> would be evaluated. -->
  <Target Name="GenerateCycloneDxSbom"
          BeforeTargets="GenerateNuspec;_GetPackageFiles"
          Condition="'$(IsPackable)' != 'false'">
    <Exec Command="dotnet CycloneDX &quot;$(MSBuildProjectFullPath)&quot; --output &quot;$(IntermediateOutputPath.TrimEnd('\').TrimEnd('/'))&quot; --filename bom.json --json"
          IgnoreExitCode="true"
          ContinueOnError="WarnAndContinue">
      <Output TaskParameter="ExitCode" PropertyName="_CycloneDxExitCode" />
    </Exec>
    <Message Importance="high"
             Text="CycloneDX SBOM not generated (tool missing or failed, exit=$(_CycloneDxExitCode)). Install with: `dotnet tool install` (global, id=CycloneDX)."
             Condition="'$(_CycloneDxExitCode)' != '0'" />
    <ItemGroup Condition="Exists('$(IntermediateOutputPath)bom.json')">
      <None Include="$(IntermediateOutputPath)bom.json" Pack="true" PackagePath="\" />
    </ItemGroup>
    <Message Importance="high"
             Text="CycloneDX SBOM packed into .nupkg at /bom.json"
             Condition="Exists('$(IntermediateOutputPath)bom.json')" />
  </Target>

</Project>
